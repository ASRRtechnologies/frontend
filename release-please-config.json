{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"bump-minor-pre-major": true,
	"include-component-in-tag": true,
	"plugins": [
		{
			"type": "node-workspace",
			"updatePeerDependencies": false
		}
	],
	"packages": {
		"packages/utils": {
			"component": "utils",
			"release-as": "0.1.0"
		},
		"packages/ui": {
			"component": "ui",
			"release-as": "2.0.0"
		}
	},
	"changelog-sections": [
		{
			"type": "feat",
			"section": "Added"
		},
		{
			"type": "fix",
			"section": "Fixed"
		},
		{
			"type": "perf",
			"section": "Performance"
		},
		{
			"type": "revert",
			"section": "Reverted"
		},
		{
			"type": "refactor",
			"section": "Changed",
			"hidden": true
		},
		{
			"type": "docs",
			"section": "Documentation",
			"hidden": true
		},
		{
			"type": "ci",
			"section": "CI",
			"hidden": true
		},
		{
			"type": "chore",
			"section": "Chores",
			"hidden": true
		},
		{
			"type": "test",
			"section": "Tests",
			"hidden": true
		}
	]
}
